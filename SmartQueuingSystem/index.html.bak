<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Smart Queuing System</title>

    <link rel="stylesheet" href="style.css">

</head>


<body>


    <!-- HEADER -->

    <header>

        <h1>Smart Queuing System</h1>

        <p>Queue smarter. Wait less.</p>

    </header>



    <main>


        <!-- WELCOME SECTION -->

        <section class="welcome">

            <h2>Welcome</h2>

            <p>
                Select a service and generate your digital token.
            </p>

        </section>



        <!-- SERVICE SELECTION -->

        <section class="queue-box">

            <h2>Select Service</h2>


            <select id="service">

                <option value="">
                    -- Select Service --
                </option>

                <option value="Fee Payment">
                    Fee Payment
                </option>

                <option value="Admission">
                    Admission
                </option>

                <option value="Certificate">
                    Certificate
                </option>

                <option value="General Enquiry">
                    General Enquiry
                </option>

            </select>



            <!-- PRIORITY OPTION -->

            <div class="priority-option">

                <label>

                    <input
                        type="checkbox"
                        id="priority"
                    >

                    Priority Service

                </label>

            </div>



            <!-- GET TOKEN BUTTON -->

            <button onclick="generateToken()">

                Get Token

            </button>


        </section>



        <!-- USER TOKEN SECTION -->

        <section
            id="tokenSection"
            class="token-box"
        >

            <h2>Your Token</h2>


            <div id="tokenNumber">
                ---
            </div>


            <p>

                Currently Serving:

                <span id="currentToken">
                    ---
                </span>

            </p>


            <p>

                People Ahead:

                <span id="peopleAhead">
                    ---
                </span>

            </p>


            <p>

                Estimated Waiting Time:

                <span id="waitingTime">
                    ---
                </span>

            </p>


            <p>

                Status:

                <span id="status">
                    ---
                </span>

            </p>


        </section>



        <!-- MY TOKENS -->

        <section class="queue-box">

            <h2>My Tokens</h2>


            <div id="myTokensList">

                <p>
                    No tokens generated yet.
                </p>

            </div>


            <button onclick="clearAllMyTokens()">

                Clear My Token List

            </button>


        </section>



        <!-- LIVE QUEUE -->

        <section class="queue-box">

            <h2>Live Queue</h2>


            <div id="queueList">

                <p>
                    No tokens in queue.
                </p>

            </div>


            <!-- CLEAR LIVE QUEUE (NEW) -->

            <button class="clear-btn" onclick="clearData('queue')">

                Clear Live Queue

            </button>


        </section>



        <!-- QUEUE STATISTICS -->

        <section class="queue-box statistics">

            <h2>Queue Statistics</h2>


            <div class="stat-container">


                <!-- TOTAL TOKENS -->

                <div class="stat-card">

                    <h3 id="totalTokens">
                        0
                    </h3>

                    <p>
                        Total Tokens
                    </p>

                </div>



                <!-- WAITING TOKENS -->

                <div class="stat-card">

                    <h3 id="waitingTokens">
                        0
                    </h3>

                    <p>
                        Waiting
                    </p>

                </div>

                <!-- SERVING TOKENS -->

                <div class="stat-card">

                    <h3 id="servingTokens">
                        0
                    </h3>

                    <p>
                        Serving
                    </p>

                </div>

                <!-- COMPLETED TOKENS -->

                <div class="stat-card">

                    <h3 id="completedTokens">
                        0
                    </h3>

                    <p>
                        Completed
                    </p>

                </div>


            </div>


            <!-- CLEAR STATISTICS (NEW) -->

            <button class="clear-btn" onclick="clearData('all')">

                Clear Statistics

            </button>


        </section>



        <!-- STAFF DASHBOARD -->

        <section class="queue-box staff-dashboard">

            <h2>Staff Dashboard</h2>


            <!-- CURRENTLY SERVING -->

            <div class="current-serving">

                <p>
                    Currently Serving
                </p>


                <div id="staffCurrentToken">
                    No Token
                </div>

                <p id="staffCurrentService">
                    No Service
                </p>

                <p id="staffCurrentPriority">
                    Normal
                </p>

            </div>



            <!-- CALL NEXT -->

            <button onclick="callNextToken()">

                Call Next Token

            </button>



            <!-- COMPLETE -->

            <button onclick="completeToken()">

                Complete Token

            </button>



            <!-- SKIP -->

            <button onclick="skipToken()">

                Skip Token

            </button>


        </section>


    </main>



    <!-- FOOTER -->

    <footer>

        <p>
            Smart Queuing System © 2026
        </p>

    </footer>



    <!-- JAVASCRIPT -->

    <script src="script.js"></script>


</body>

</html>